-- ==========================================
-- แท็บที่ 1: ผู้เล่น (Player)
-- ==========================================
local PlayerPage = UI:addPage("ผู้เล่น", 5012544693)
local PlayerSection = PlayerPage:addSection("ปรับแต่งตัวละคร")

PlayerSection:addSlider("ความเร็วเดิน (WalkSpeed)", 16, 16, 200, function(value)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = value
    end
end)

PlayerSection:addSlider("แรงกระโดด (JumpPower)", 50, 50, 300, function(value)
