local noclipEnabled = false

MiscSection:addToggle("เดินทะลุกำแพง (Noclip)", false, function(value)
    noclipEnabled = value
end)

MiscSection:addKeybind("ปุ่มเปิด/ปิด UI", Enum.KeyCode.LeftControl, function()
